# Firebase Web SDK - dùng cho trang đăng nhập admin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Firebase Admin SDK - chọn một trong hai cách cấu hình bên dưới.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Hoặc dán service-account JSON nguyên bản/base64 vào một biến.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_KEY=

# Cookie quản trị HttpOnly ký bằng HMAC (tối thiểu 32 ký tự, không commit).
ADMIN_SESSION_SECRET=

# Tài khoản seed admin cục bộ.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

ADMIN_APP_URL=http://localhost:3000

# FastAPI History-Chatbot
AI_BACKEND_URL=http://127.0.0.1:8000
AI_REQUIRED_RAG_REVISION=recoverable-boundary-evolution-planning-f9-v28
AI_MAX_PDF_SIZE_MB=200
AI_INDEX_TIMEOUT_MS=7100000
AI_PDF_STORAGE_DRIVER=local
AI_PDF_LOCAL_DIR=.data
AI_ADMIN_API_KEY=replace-with-the-same-secret-as-history-chatbot
FIREBASE_STORAGE_BUCKET=lichsuvietnam-d3c26.firebasestorage.app
