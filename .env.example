# Firebase Web SDK - dùng cho trang đăng nhập admin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK - chọn một trong hai cách cấu hình bên dưới.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Hoặc dán service-account JSON nguyên bản/base64 vào một biến.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_KEY=

# Tài khoản seed admin cục bộ.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Neo4j Graph Database.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# AI provider tùy chọn.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

ADMIN_APP_URL=http://localhost:3000
